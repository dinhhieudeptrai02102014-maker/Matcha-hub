-- // Helper Functions
local function GetScreenCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function IsAlive(player)
    return player 
        and player.Character 
        and player.Character:FindFirstChildOfClass("Humanoid") 
        and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 
        and player.Character:FindFirstChild("HumanoidRootPart")
end

local function IsOnSameTeam(player)
    if not Settings.Aimbot.TeamCheck then return false end
    return player.Team == LocalPlayer.Team
end

-- // Target Acquisition Logic
local function GetClosestTarget()
    local Target = nil
    local MaxDistance = Settings.FOV.Radius
    local Center = GetScreenCenter()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsAlive(player) and not IsOnSameTeam(player) then
            local AimPart = player.Character:FindFirstChild(Settings.Aimbot.AimPart) or player.Character:FindFirstChild("HumanoidRootPart")
            if AimPart then
                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(AimPart.Position)
                if OnScreen then
                    local Distance = (Vector2.new(ScreenPos.X, ScreenPos.Y) - Center).Magnitude
                    if Distance < MaxDistance then
                        MaxDistance = Distance
                        Target = player
                    end
                end
            end
        end
    end
    return Target
end

-- // Anti-Cheat Security Bypass Hooking (Silent Aim & Vector Redirection)
local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local Method = getnamecallmethod()
    local Args = {...}

    if not checkcaller() and Settings.Aimbot.Enabled then
        if Method == "FindPartOnWithIgnoreList" or Method == "Raycast" or Method == "FindPartOnWithWhitelist" or Method == "FindPartOnWithIgnorelist" then
            local Target = GetClosestTarget()
            if Target and Target.Character then
                local AimPart = Target.Character:FindFirstChild(Settings.Aimbot.AimPart)
                if AimPart then
                    if Method == "Raycast" then
                        -- Redirect direction vector to target position
                        local Origin = Args[1]
                        Args[2] = (AimPart.Position - Origin).Unit * 10000
                        return OldNamecall(self, unpack(Args))
                    else
                        -- Override hit position for older raycasting methods
                        local HitPosition = AimPart.Position
                        return AimPart, HitPosition, Vector3.new(0, 1, 0), AimPart.Material
                    end
                end
            end
        end
    end

    return OldNamecall(self, ...)
end))

