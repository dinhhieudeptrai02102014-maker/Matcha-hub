    -- Sky Aimbot & Camera Steering Engine
    if Settings.Aimbot.Enabled then
        local Target = GetClosestTarget()
        if Target and Target.Character then
            local AimPart = Target.Character:FindFirstChild(Settings.Aimbot.AimPart)
            if AimPart then
                if Settings.Aimbot.SkyAimbot then
                    -- Hướng Camera lên bầu trời để đánh lừa quan sát nhưng vẫn lock bằng Silent Aim
                    local CurrentPos = Camera.CFrame.Position
                    local SkyVector = Vector3.new(CurrentPos.X, CurrentPos.Y + 500, CurrentPos.Z)
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(CurrentPos, SkyVector), Settings.Aimbot.Smoothness)
                else
                    -- Direct Smooth Lock
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, AimPart.Position), Settings.Aimbot.Smoothness)
                end
            end
        end
    end
end)

-- // ESP Framework Engine
local function CreateESP(player)
    local Drawables = {
        Box = Drawing.new("Square"),
        Tracer = Drawing.new("Line"),
        Name = Drawing.new("Text")
    }

    Drawables.Box.Visible = false
    Drawables.Box.Color = Settings.ESP.BoxColor
    Drawables.Box.Thickness = 1.5
    Drawables.Box.Filled = false

    Drawables.Tracer.Visible = false
    Drawables.Tracer.Color = Settings.ESP.TracerColor
    Drawables.Tracer.Thickness = 1

    Drawables.Name.Visible = false
    Drawables.Name.Color = Settings.ESP.NameColor
    Drawables.Name.Size = 13
    Drawables.Name.Center = true
    Drawables.Name.Outline = true

    ESPStorage[player] = Drawables
end

local function RemoveESP(player)
    if ESPStorage[player] then
        for _, obj in pairs(ESPStorage[player]) do
            obj:Remove()
        end
        ESPStorage[player] = nil
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then CreateESP(player) end
end

Players.PlayerAdded:Connect(function(player)
    if player ~= LocalPlayer then CreateESP(player) end
end)

Players.PlayerRemoving:Connect(function(player)
    RemoveESP(player)
end)

RunService.RenderStepped:Connect(function()
    for player, drawables in pairs(ESPStorage) do
        if Settings.ESP.Enabled and IsAlive(player) and not (Settings.ESP.TeamCheck and IsOnSameTeam(player)) then
            local RootPart = player.Character:FindFirstChild("HumanoidRootPart")
            local Head = player.Character:FindFirstChild("Head")
            
            if RootPart and Head then
                local RootPos, OnScreen = Camera:WorldToViewportPoint(RootPart.Position)
                local HeadPos = Camera:WorldToViewportPoint(Head.Position + Vector3.new(0, 0.5, 0))
                local LegPos = Camera:WorldToViewportPoint(RootPart.Position - Vector3.new(0, 3, 0))

                if OnScreen then
                    -- 2D Bounding Box
                    if Settings.ESP.Boxes then
                        local Height = math.abs(HeadPos.Y - LegPos.Y)
                        local Width = Height / 1.8
                        drawables.Box.Size = Vector2.new(Width, Height)
                        drawables.Box.Position = Vector2.new(RootPos.X - Width / 2, RootPos.Y - Height / 2)
                        drawables.Box.Color = Settings.ESP.BoxColor
                        drawables.Box.Visible = true
                    else
                        drawables.Box.Visible = false
                    end

                    -- Snap Lines / Tracers
                    if Settings.ESP.Tracers then
                        drawables.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        drawables.Tracer.To = Vector2.new(RootPos.X, RootPos.Y)
                        drawables.Tracer.Color = Settings.ESP.TracerColor
                        drawables.Tracer.Visible = true
                    else
                        drawables.Tracer.Visible = false
                    end

                    -- Name Tags
                    if Settings.ESP.Names then
                        drawables.Name.Text = player.Name
                        drawables.Name.Position = Vector2.new(RootPos.X, HeadPos.Y - 16)
                        drawables.Name.Visible = true
                    else
                        drawables.Name.Visible = false
                    end
                else
                    drawables.Box.Visible = false
                    drawables.Tracer.Visible = false
                    drawables.Name.Visible = false
                end
            end
        else
            drawables.Box.Visible = false
            drawables.Tracer.Visible = false
            drawables.Name.Visible = false
        end
    end
end)

